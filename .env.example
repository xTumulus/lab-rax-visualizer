# Copy this file to .env and fill in your own value(s).
# .env is gitignored — it will never be committed or pushed to the public repo.

# Buy Me a Coffee link shown in the app's support panel.
# Leave unset (or delete the line) to hide the panel entirely — e.g. for
# a fork/deploy that isn't yours to solicit support for.
VITE_SUPPORT_BMC_URL=https://buymeacoffee.com/your-username
